{
  "name": "dsh-fnos-advanced",
  "version": "0.3.0",
  "description": "飞牛文件与目录桥：从飞牛选目录/文件进 dsh，非图片零拷贝引用、图片按需读取。fnOS picker and file bridge for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fnos",
    "workspace",
    "directory-picker",
    "file-picker",
    "attachments"
  ],
  "license": "MIT",
  "author": "shuangji66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuangji66/dsh.git",
    "directory": "dsh-fnos-advanced"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@trimjs/web-app": "^0.5.0",
    "esbuild": "^0.25.0"
  }
}
